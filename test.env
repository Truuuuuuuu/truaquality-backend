# Test-only dummy values. Never put a real secret or a non-local URL here.
# Variables exported in your shell OVERRIDE these; the test guard refuses non-local DB URLs.
#
# Port 1 makes any stray real query fail in ~30 ms instead of hanging. The broker credentials, the
# Supabase secret key and DIRECT_URL are deliberately absent, so an accidental import of
# readingsSubscriber.ts or supabaseAdmin.ts fails loudly instead of connecting to anything.
DATABASE_URL=postgresql://test:test@127.0.0.1:1/truaquality_test
DEVICE_SECRET_MASTER_KEY=test-only-master-key-0123456789abcdef
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=test-publishable-key
