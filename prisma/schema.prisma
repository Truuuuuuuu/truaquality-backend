// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SystemRole {
  ADMIN
  USER
}

enum ProfileStatus {
  INVITED
  ACTIVE
  DISABLED
}

// id mirrors Supabase auth.users.id; credentials live in Supabase Auth, not here.
model Profile {
  id            String         @id @db.Uuid
  email         String         @unique
  fullName      String
  systemRole    SystemRole     @default(USER)
  status        ProfileStatus  @default(INVITED)
  invitedById   String?        @db.Uuid
  invitedBy     Profile?       @relation("ProfileInvites", fields: [invitedById], references: [id], onDelete: SetNull)
  invitees      Profile[]      @relation("ProfileInvites")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  notifications Notification[]
}

// No FK on actorId so audit rows survive profile deletion.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId])
}

enum PondStatus {
  ACTIVE
  ARCHIVED
}

enum DeviceStatus {
  ACTIVE
  DISABLED
}

// Ponds are archived, never deleted, so their reading history stays intact.
model Pond {
  id             String          @id @default(uuid()) @db.Uuid
  name           String          @unique
  notes          String?
  status         PondStatus      @default(ACTIVE)
  device         Device?
  readings       Reading[]
  readingsHourly ReadingHourly[]
  alerts         Alert[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

// One ESP32 sensor unit. It signs every MQTT message with a secret derived from DEVICE_SECRET_MASTER_KEY, its
// id, and secretVersion (nothing secret is stored; rotating bumps the version). It never knows its pond —
// ingest resolves the pond from pondId, so moving hardware is a reassignment.
model Device {
  id              String       @id @default(uuid()) @db.Uuid
  serial          String       @unique
  hardwareModel   String?
  label           String?
  secretVersion   Int          @default(1)
  status          DeviceStatus @default(ACTIVE)
  pondId          String?      @unique @db.Uuid
  pond            Pond?        @relation(fields: [pondId], references: [id], onDelete: SetNull)
  // When the device was last put on its current pond. Samples recorded earlier are refused, so a captured
  // message can't be replayed into the pond the device was moved to.
  assignedAt      DateTime?
  firmwareVersion String?
  lastSeenAt      DateTime?
  readings        Reading[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

// One row per parameter per sample, so adding a sensor parameter needs no migration. pondId is copied at
// ingest time so history stays with the pond it was measured in after a device is reassigned.
model Reading {
  id         BigInt   @id @default(autoincrement())
  pondId     String   @db.Uuid
  pond       Pond     @relation(fields: [pondId], references: [id], onDelete: Restrict)
  deviceId   String   @db.Uuid
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  parameter  String
  value      Float
  recordedAt DateTime
  receivedAt DateTime @default(now())

  // Lets a device safely retry an upload: duplicates are skipped instead of double-counted.
  @@unique([deviceId, parameter, recordedAt])
  @@index([pondId, parameter, recordedAt(sort: Desc)])
  // Lets the retention job find and delete old rows without scanning the whole table.
  @@index([recordedAt])
}

// One row per pond/parameter/hour, kept forever after the matching raw Reading rows age out of the
// retention window. sum+count (not avg) so a day/year rollup can still weight each hour by how many
// samples it actually had.
model ReadingHourly {
  pondId      String   @db.Uuid
  pond        Pond     @relation(fields: [pondId], references: [id], onDelete: Restrict)
  parameter   String
  bucketStart DateTime
  min         Float
  max         Float
  sum         Float
  count       Int

  @@id([pondId, parameter, bucketStart])
}

enum AlertSeverity {
  WARNING
  CRITICAL
}

enum NotificationKind {
  ALERT_OPENED
  ALERT_ESCALATED
  ALERT_RESOLVED
}

// One out-of-range episode for a pond's parameter, from its first abnormal reading until readings have stayed
// in range for a while (lib/alerts.ts). Readings arrive every minute, so notifying per episode — not per
// reading — is what keeps a bad afternoon from becoming hundreds of notifications.
model Alert {
  id             String         @id @default(uuid()) @db.Uuid
  pondId         String         @db.Uuid
  pond           Pond           @relation(fields: [pondId], references: [id], onDelete: Restrict)
  parameter      String
  // The worst severity reached during the episode; it never steps back down, so it escalates at most once.
  severity       AlertSeverity
  openedAt       DateTime
  // The newest reading evaluated against this alert, so a re-delivered or older reading is never re-applied.
  lastValue      Float
  lastRecordedAt DateTime
  // Set by the first in-range reading after an abnormal one, cleared if the value leaves the range again.
  nominalSince   DateTime?
  resolvedAt     DateTime?
  notifications  Notification[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([pondId, parameter, resolvedAt])
}

// One row per recipient per alert event, so each user has their own read state. value/recordedAt/severity
// are a snapshot of the reading that caused the event; the alert itself keeps moving.
model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  profileId  String           @db.Uuid
  profile    Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  alertId    String           @db.Uuid
  alert      Alert            @relation(fields: [alertId], references: [id], onDelete: Cascade)
  kind       NotificationKind
  severity   AlertSeverity
  value      Float
  recordedAt DateTime
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  @@index([profileId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([profileId, readAt])
}
